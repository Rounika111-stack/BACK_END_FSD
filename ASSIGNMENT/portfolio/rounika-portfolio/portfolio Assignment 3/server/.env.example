# Server Configuration
# Note: On macOS, port 5000 is often reserved by AirPlay Receiver (ControlCenter), so port 5001 is recommended.
PORT=5001
CLIENT_URL=http://localhost:5173

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Contact Destination & Sender
CONTACT_EMAIL=rouni.tiwari2013@gmail.com
CONTACT_FROM=Portfolio Contact <no-reply@rounikatiwari.dev>
